# Скопируй в .env и заполни. .env никогда не коммитить в git.

PORT=8080

DATABASE_URL=postgres://platform:platform_dev_password@localhost:5432/platform_core?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Пути к RSA-ключам для подписи JWT (RS256). Сгенерировать через `make gen-keys`.
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

# Время жизни токенов
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=720

# Кэш вычисленных прав доступа (TTL в секундах)
RBAC_CACHE_TTL_SECONDS=60

# Rate limiting (защита /auth/login и /auth/register от брутфорса, см. docs/security.md)
# Поведение при недоступности Redis: "open" (пропустить запрос) или
# "closed" (отклонить). По умолчанию open — недоступность Redis не должна сама
# по себе становиться DoS (никто не может залогиниться, потому что упал кэш).
RATE_LIMIT_FAIL_MODE=open

# Login: лимит по IP и отдельно по аккаунту (email) — защита от credential stuffing
LOGIN_RATE_LIMIT_PER_IP=10
LOGIN_RATE_LIMIT_IP_WINDOW_MINUTES=5
LOGIN_RATE_LIMIT_PER_ACCOUNT=5
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_MINUTES=15

# Register: лимит по IP
REGISTER_RATE_LIMIT_PER_IP=20
REGISTER_RATE_LIMIT_IP_WINDOW_MINUTES=60
